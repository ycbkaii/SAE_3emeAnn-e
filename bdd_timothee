-- Table: Awards
CREATE TABLE _awards (
    id_awards SERIAL PRIMARY KEY,
    nom_awards VARCHAR(255)
);

-- Table: possede_serie (Saga Has Book)
CREATE TABLE _possede_serie (
    id_saga INT,
    id_livre INT,
    numero_opus INT,
    PRIMARY KEY (id_saga, id_livre),
    FOREIGN KEY (id_saga) REFERENCES saga(id_saga),
    FOREIGN KEY (id_livre) REFERENCES livre(id_livre)
);

-- Table: recompense_en (Book Wins Award)
CREATE TABLE _recompense_en (
    id_livre INT,
    id_awards INT,
    date DATE,
    PRIMARY KEY (id_livre, id_awards, date),
    FOREIGN KEY (id_livre) REFERENCES livre(id_livre),
    FOREIGN KEY (id_awards) REFERENCES awards(id_awards)
);

-- Table: Saga (Series)
CREATE TABLE saga (
    id_saga SERIAL PRIMARY KEY,
    nom_de_la_saga VARCHAR(255),
);


--Vue : Pour calculer dynamiquement le nombre de livres dans chaque saga
CREATE VIEW nb_livre_in_saga AS
SELECT id_saga, COUNT(*) AS nb_livre_in_saga
FROM livre
GROUP BY id_saga;

--jointure entre la table saga et la vue nb_livre_in_saga :
SELECT s.id_saga, s.nom_de_la_saga, v.nb_livre_in_saga
FROM saga s
LEFT JOIN nb_livre_in_saga v ON s.id_saga = v.id_saga;

